---
import { getCollection } from "astro:content";
import SchedaCamera from "./SchedaCamera.astro";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

const camere = await getCollection("camere");
const nomi = Object.fromEntries(camere.map((c) => [c.id, c.data.nome[lingua]]));
const perId = Object.fromEntries(camere.map((c) => [c.id, c]));

/** La camera mostrata all'apertura e senza JavaScript. */
const PREDEFINITA = "deluxe";

// Aree sensibili: conoscono l'identificativo della camera, non i suoi dati
// (spec 005, FR-005).
const puntiProspetto = [
  { k: "suite", x: 340, y: 6, w: 324, h: 34 },
  { k: "superior", x: 40, y: 6, w: 260, h: 34 },
  { k: "standard", x: 336, y: 56, w: 152, h: 134 },
  { k: "deluxe", x: 488, y: 56, w: 172, h: 134 },
  { k: "androne", x: 168, y: 404, w: 108, h: 136 },
];

const puntiSezione = [
  { k: "suite", x: 60, y: 92, w: 440, h: 88 },
  { k: "comuni", x: 60, y: 180, w: 440, h: 26 },
  { k: "standard", x: 60, y: 206, w: 150, h: 84 },
  { k: "superior", x: 238, y: 220, w: 114, h: 62 },
  { k: "deluxe", x: 380, y: 206, w: 120, h: 84 },
  { k: "androne", x: 60, y: 400, w: 496, h: 90 },
];

const ordineSchede = ["deluxe", "standard", "superior", "suite", "comuni", "androne"];
