<script>
  // Segna la pagina come «con JavaScript»: gli stati iniziali nascosti delle
  // animazioni valgono solo sotto questa classe, così senza JavaScript il
  // disegno resta visibile invece di sparire (spec 005, SC-005).
  document.documentElement.classList.add("js");

  const $ = (id: string) => document.getElementById(id);

  const paneP = $("paneP");
  const paneS = $("paneS");
  const tabP = $("tab-prospetto");
  const tabS = $("tab-sezione");
  const viewbox = $("viewbox");
  const info = $("info-camera");
  const hint = $("lockhint");

  const pannelli = info
    ? [...info.querySelectorAll<HTMLElement>("[data-camera-id]")]
    : [];

  let bloccata: string | null = null;

  function mostra(k: string) {
    let trovata = false;
    for (const p of pannelli) {
      const suo = p.dataset.cameraId === k;
      p.hidden = !suo;
      if (suo) trovata = true;
    }
    if (!trovata) return;
    document.querySelectorAll<SVGElement>(".rm").forEach((r) => {
      r.classList.toggle("on", (r as SVGElement).dataset.k === k);
    });
  }

  function aggiornaHint() {
    if (!hint) return;
    hint.hidden = false;
    hint.textContent = bloccata
      ? (hint.dataset.bloccata ?? "")
      : (hint.dataset.esplora ?? "");
  }

  function collega() {
    document.querySelectorAll<SVGElement>(".rm").forEach((el) => {
      if (el.dataset.collegato) return;
      el.dataset.collegato = "1";
      const k = el.dataset.k!;
      el.addEventListener("mouseenter", () => {
        if (!bloccata) mostra(k);
      });
      el.addEventListener("focus", () => {
        if (!bloccata) mostra(k);
      });
      const scegli = () => {
        bloccata = bloccata === k ? null : k;
        mostra(k);
        aggiornaHint();
      };
      el.addEventListener("click", scegli);
      el.addEventListener("keydown", (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key === "Enter" || ev.key === " ") {
          ev.preventDefault();
          scegli();
        }
      });
    });
  }

  function ridisegna() {
    if (!viewbox) return;
    viewbox.classList.remove("go-anim");
    void viewbox.offsetWidth;
    viewbox.classList.add("go-anim");
  }

  function vista(sezione: boolean) {
    if (!paneP || !paneS || !tabP || !tabS) return;
    paneP.hidden = sezione;
    paneS.hidden = !sezione;
    tabP.setAttribute("aria-selected", String(!sezione));
    tabS.setAttribute("aria-selected", String(sezione));
    collega();
    // La camera scelta resta la stessa se esiste anche nell'altra vista.
    const corrente = pannelli.find((p) => !p.hidden)?.dataset.cameraId;
    if (corrente) mostra(corrente);
    ridisegna();
  }

  tabP?.addEventListener("click", () => vista(false));
  tabS?.addEventListener("click", () => vista(true));
  $("replay")?.addEventListener("click", ridisegna);

  collega();
  aggiornaHint();

  if (viewbox) {
    const osservatore = new IntersectionObserver(
      (voci, o) => {
        for (const v of voci) {
          if (v.isIntersecting) {
            ridisegna();
            o.disconnect();
          }
        }
      },
      { threshold: 0.35 },
    );
    osservatore.observe(viewbox);
  }

  // Galleria dentro il pannello di camera.
  info?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(
      ".gal .thumbs button",
    );
    if (!b) return;
    const gal = b.closest(".gal")!;
    const i = b.dataset.i;
    gal.querySelectorAll<HTMLElement>(".main img").forEach((img) => {
      img.classList.toggle("on", img.dataset.i === i);
    });
    gal.querySelectorAll<HTMLElement>(".thumbs button").forEach((t) => {
      t.setAttribute("aria-current", String(t.dataset.i === i));
    });
    const cap = gal.querySelector("[data-didascalia]");
    const alt = gal.querySelector<HTMLImageElement>(`.main img[data-i="${i}"]`)?.alt;
    if (cap && alt) cap.textContent = alt;
  });
</script>
