---
import { Picture } from "astro:assets";
import { fotoConRuolo, didascalia } from "../data/foto";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

const facciata = fotoConRuolo("facciata-bifore");
---

<section id="palazzo">
  <div class="wrap">
    <div class="sec-h">
      <h2>{testi.palazzo.titolo}</h2>
      <p class="kicker">{testi.palazzo.occhiello}</p>
    </div>

    <div class="storygrid">
      <div>
        <p>{testi.palazzo.p1}</p>
        <p>{testi.palazzo.p2}</p>
        <p>
          <span class="todo">{testi.palazzo.daVerificare}</span>
          {testi.palazzo.p3}
        </p>
      </div>

      <figure>
        <Picture
          formats={["webp"]}
          fallbackFormat="jpeg"
          src={facciata.immagine}
          alt={didascalia(facciata, lingua)}
          widths={[480, 800, 1200]}
          sizes="(max-width: 820px) 100vw, 540px"
          loading="lazy"
        />
        <figcaption>{testi.palazzo.didascalia}</figcaption>
      </figure>
    </div>
  </div>
</section>
