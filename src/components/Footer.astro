---
import { casa } from "../data/casa";
import { linkWhatsApp, richiestaVuota } from "../data/prenotazione";
import {
  LINGUE,
  NOME_LINGUA,
  TRADUZIONE_RIVISTA,
  percorso,
  t,
  type Lingua,
} from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

const wa = linkWhatsApp(lingua, richiestaVuota(lingua));

// Le pagine locali della feature 010 non esistono ancora: finché non hanno un
// contenuto proprio non vanno pubblicate (spec 010, FR-008), quindi qui
// l'elenco è vuoto e la colonna non compare.
const pagineLocali: { href: string; testo: string }[] = [];
---

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h2>{casa.nome}</h2>
        <p style="margin:0">
          {casa.palazzo}<br />
          {casa.indirizzo.via}<br />
          {casa.indirizzo.cap} {casa.indirizzo.citta} · {casa.indirizzo.quartiere}
        </p>
      </div>

      <div>
        <h2>{testi.footer.prenotaDiretto}</h2>
        <ul>
          <li><a href="#prenota">{testi.footer.verificaDisponibilita}</a></li>
          <li>
            <a data-wa href={wa} target="_blank" rel="noopener">
              {testi.footer.scriviciWhatsApp}
            </a>
          </li>
          <li><a href="#suite">{testi.footer.laSuite}</a></li>
        </ul>
      </div>

      {
        pagineLocali.length > 0 && (
          <div>
            <h2>{testi.footer.dormireAOrtigia}</h2>
            <ul>
              {pagineLocali.map((p) => (
                <li><a href={p.href}>{p.testo}</a></li>
              ))}
            </ul>
          </div>
        )
      }

      <nav aria-label={testi.footer.selettoreLingua}>
        <h2>{testi.footer.lingue}</h2>
        <ul>
          {
            LINGUE.map((l) => (
              <li>
                <a
                  href={percorso(l, "/")}
                  hreflang={l}
                  lang={l}
                  aria-current={l === lingua ? "true" : undefined}
                  style={l === lingua ? "text-decoration:underline" : undefined}
                >
                  {NOME_LINGUA[l]}
                </a>
                {!TRADUZIONE_RIVISTA[l] && (
                  <span class="todo">{t(l).traduzione.bozza}</span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="legal">
      <span>{testi.footer.cin} {casa.cin.valore}</span>
      <span>{testi.footer.privacy}</span>
      <span>{testi.footer.cookie}</span>
      <span>{testi.footer.condizioni}</span>
    </div>
  </div>
</footer>
