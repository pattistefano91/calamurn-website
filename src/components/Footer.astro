---
import { casa } from "../data/casa";
import { linkWhatsApp, richiestaVuota } from "../data/prenotazione";

// Indirizzo di partenza: il collegamento funziona anche senza JavaScript, che
// poi lo aggiorna con le date scelte (spec 003, FR-011).
const wa = linkWhatsApp(richiestaVuota);

// Le pagine locali della feature 010 non esistono ancora: finché non hanno un
// contenuto proprio non vanno pubblicate (spec 010, FR-008), quindi qui
// l'elenco è vuoto e la colonna non compare.
const pagineLocali: { href: string; testo: string }[] = [];

// Le altre lingue arrivano con la feature 009: elencarle ora porterebbe a
// pagine inesistenti.
const lingue = [{ codice: "it", nome: "Italiano", href: "/" }];
---

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h2>{casa.nome}</h2>
        <p style="margin:0">
          {casa.palazzo}<br />
          {casa.indirizzo.via}<br />
          {casa.indirizzo.cap} {casa.indirizzo.citta} · {casa.indirizzo.quartiere}
        </p>
      </div>

      <div>
        <h2>Prenota diretto</h2>
        <ul>
          <li><a href="#prenota">Verifica disponibilità</a></li>
          <li>
            <a data-wa href={wa} target="_blank" rel="noopener">
              Scrivici su WhatsApp
            </a>
          </li>
          <li><a href="#suite">La suite con il terrazzo</a></li>
        </ul>
      </div>

      {
        pagineLocali.length > 0 && (
          <div>
            <h2>Dormire a Ortigia</h2>
            <ul>
              {pagineLocali.map((p) => (
                <li><a href={p.href}>{p.testo}</a></li>
              ))}
            </ul>
          </div>
        )
      }

      <div>
        <h2>Lingue</h2>
        <ul>
          {lingue.map((l) => <li><a href={l.href}>{l.nome}</a></li>)}
        </ul>
        <p style="margin:10px 0 0;font-size:12px">
          <span class="todo">in lavorazione</span>
          English, Français e Deutsch arrivano con la traduzione completa.
        </p>
      </div>
    </div>

    <div class="legal">
      <span>CIN {casa.cin.valore}</span>
      <span>Privacy</span>
      <span>Cookie</span>
      <span>Condizioni</span>
    </div>
  </div>
</footer>
