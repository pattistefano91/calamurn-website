---
import { Picture } from "astro:assets";
import { casa } from "../data/casa";
import { fotoDi, didascalia } from "../data/foto";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

const gradini = casa.soggiorno.gradini;
// La scala vera non è ancora fotografata, e la sezione lo dichiara.
const scatto = fotoDi("comuni-02");
---

<section id="gradini">
  <div class="wrap">
    <div class="stairs">
      <div>
        <p class="kicker">{testi.gradini.occhiello}</p>
        <div class="big">
          {gradini.valore ?? "__"}<span>{testi.gradini.gradini}</span>
        </div>
        <p>
          {!gradini.confermato && <span class="todo">{testi.gradini.daContare}</span>}
          {testi.gradini.testo}
        </p>
      </div>

      <figure style="margin:0">
        <Picture
          formats={["webp"]}
          fallbackFormat="jpeg"
          src={scatto.immagine}
          alt={didascalia(scatto, lingua)}
          widths={[480, 800, 1200]}
          sizes="(max-width: 760px) 100vw, 600px"
          loading="lazy"
        />
        <figcaption
          style="font-family:var(--mono);font-size:10.5px;color:var(--ink-30);margin-top:8px"
        >
          <span class="todo">{testi.gradini.fotoDaFare}</span>
          {testi.gradini.didascalia}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
