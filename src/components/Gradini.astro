---
import { Picture } from "astro:assets";
import { casa } from "../data/casa";
import { fotoDi } from "../data/foto";

const gradini = casa.soggiorno.gradini;
// «Il corridoio e la nicchia dei fichi d'India»: la scala vera non è ancora
// fotografata, e la sezione lo dichiara.
const scatto = fotoDi("comuni-02");
---

<section id="gradini">
  <div class="wrap">
    <div class="stairs">
      <div>
        <p class="kicker">Onestà preventiva</p>
        <div class="big">
          {gradini.valore ?? "__"}<span>gradini</span>
        </div>
        <p>
          {!gradini.confermato && <span class="todo">da contare</span>}
          Le camere sono al penultimo piano, la suite all'ultimo, e nel palazzo non
          c'è ascensore. Preferiamo dirlo qui, in home, invece di lasciartelo
          scoprire con la valigia in mano.
        </p>
      </div>

      <figure style="margin:0">
        <Picture formats={["webp"]} fallbackFormat="jpeg"
          src={scatto.immagine}
          alt={scatto.didascalia}
          widths={[480, 800, 1200]}
          sizes="(max-width: 760px) 100vw, 600px"
          loading="lazy"
        />
        <figcaption
          style="font-family:var(--mono);font-size:10.5px;color:var(--ink-30);margin-top:8px"
        >
          <span class="todo">foto da fare</span>
          Al posto della scala, per ora, il pianerottolo del secondo piano.
        </figcaption>
      </figure>
    </div>
  </div>
</section>
