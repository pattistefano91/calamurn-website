---
import { getCollection } from "astro:content";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

// Le stesse distanze della mappa: una sola fonte (spec 008, FR-011).
const luoghi = (await getCollection("luoghi"))
  .filter((l) => !l.data.casa && l.data.minuti !== null)
  .sort((a, b) => (a.data.minuti ?? 0) - (b.data.minuti ?? 0))
  .slice(0, 6);

const tuttiStimati = luoghi.every((l) => !l.data.minutiMisurati);
---

<section id="ortigia">
  <div class="wrap">
    <div class="sec-h">
      <h2>{testi.aPiedi.titolo}</h2>
      <p class="kicker">{testi.aPiedi.occhiello}</p>
    </div>

    <div class="feet">
      {
        luoghi.map((l) => (
          <div>
            <div class="n">
              {l.data.minuti}
              <em>{testi.aPiedi.min}</em>
            </div>
            <div class="t">{l.data.nome[lingua]}</div>
          </div>
        ))
      }
    </div>

    {
      tuttiStimati && (
        <p class="nota">
          <span class="todo">{testi.aPiedi.daCronometrare}</span>
          {testi.aPiedi.nota}
        </p>
      )
    }
  </div>
</section>
