---
import { getCollection } from "astro:content";

// Le stesse distanze della mappa: una sola fonte (spec 008, FR-011).
const luoghi = (await getCollection("luoghi"))
  .filter((l) => !l.data.casa && l.data.minuti !== null)
  .sort((a, b) => (a.data.minuti ?? 0) - (b.data.minuti ?? 0))
  .slice(0, 6);

const tuttiStimati = luoghi.every((l) => !l.data.minutiMisurati);
---

<section id="ortigia">
  <div class="wrap">
    <div class="sec-h">
      <h2>A piedi da qui</h2>
      <p class="kicker">nessun trasferimento, nessuna auto</p>
    </div>

    <div class="feet">
      {
        luoghi.map((l) => (
          <div>
            <div class="n">
              {l.data.minuti}
              <em>min</em>
            </div>
            <div class="t">{l.data.nome}</div>
          </div>
        ))
      }
    </div>

    {
      tuttiStimati && (
        <p class="nota">
          <span class="todo">da cronometrare</span>
          Questi minuti sono stimati, non misurati. Vanno percorsi davvero: è la
          prima cosa che gli ospiti verificano, ed è anche la più facile da
          smentire.
        </p>
      )
    }
  </div>
</section>
