---
import { Picture } from "astro:assets";
import { getEntry } from "astro:content";
import { fotoDi, didascalia } from "../data/foto";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

const suite = await getEntry("camere", "suite");
// «Il terrazzo, sotto la pergola di canne»: l'ultima delle sei principali.
const terrazzo = fotoDi(suite!.data.foto[5] ?? suite!.data.foto[0]);
---

<section id="suite">
  <div class="wrap">
    <div class="waitbox">
      <div>
        <p class="kicker" style="color:var(--acc-pale)">{testi.suite.occhiello}</p>
        <h3>{testi.suite.titolo}</h3>
        <p>{testi.suite.testo}</p>
        <p style="margin-top:18px">
          <button class="btn light" type="button" data-camera={suite!.data.nome[lingua]}>
            {testi.suite.prenota}
          </button>
        </p>
      </div>

      <figure>
        <Picture
          formats={["webp"]}
          fallbackFormat="jpeg"
          src={terrazzo.immagine}
          alt={didascalia(terrazzo, lingua)}
          widths={[480, 800, 1200]}
          sizes="(max-width: 780px) 100vw, 460px"
          loading="lazy"
        />
        <figcaption>{didascalia(terrazzo, lingua)}</figcaption>
      </figure>
    </div>
  </div>
</section>
