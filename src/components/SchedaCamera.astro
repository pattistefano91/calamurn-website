---
import { Image, Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { fotoDegli, didascalia } from "../data/foto";
import { etichetta, metraturaTesto, ospitiTesto } from "../data/dotazioni";
import { euro, t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
  camera: CollectionEntry<"camere">;
  attiva?: boolean;
}

const { lingua, camera, attiva = false } = Astro.props;
const testi = t(lingua);
const d = camera.data;
const scatti = fotoDegli(d.foto);

const specifiche = [
  metraturaTesto(d.metratura),
  ospitiTesto(lingua, d.ospitiMax),
  ...d.dotazioni.map((k) => etichetta(lingua, k)),
].filter((x): x is string => Boolean(x));
---

<div class="pannello-camera" data-camera-id={camera.id} hidden={!attiva}>
  {
    scatti.length > 0 ? (
      <div class="gal">
        <div class="main">
          {scatti.map((f, i) => (
            <Picture
              formats={["webp"]}
              fallbackFormat="jpeg"
              src={f.immagine}
              alt={didascalia(f, lingua)}
              widths={[400, 800]}
              sizes="(max-width: 900px) 100vw, 400px"
              loading="lazy"
              class={i === 0 ? "on" : ""}
              data-i={i}
            />
          ))}
        </div>
        <div class="thumbs">
          {scatti.map((f, i) => (
            <button type="button" aria-current={i === 0} data-i={i}>
              {/* Miniature da 80 px: una sola variante basta. */}
              <Image src={f.immagine} alt="" width={160} loading="lazy" />
              <span class="solo-lettori">{didascalia(f, lingua)}</span>
            </button>
          ))}
        </div>
        <p class="cap" data-didascalia>{didascalia(scatti[0], lingua)}</p>
      </div>
    ) : (
      <div class="roomshot">{testi.camere.fotografiaDaFare}</div>
    )
  }

  <p class="kicker">{d.occhiello[lingua]}</p>
  <h3>{d.nome[lingua]}</h3>
  <p class="desc">{d.descrizione[lingua]}</p>

  {
    d.avvertenza && (
      <p class="avviso" style="margin:0 0 14px">{d.avvertenza[lingua]}</p>
    )
  }

  <div class="specs">
    {specifiche.map((s) => <span>{s}</span>)}
    {
      d.metratura === null && d.prenotabile && (
        <span class="todo">{testi.camere.metraturaDaMisurare}</span>
      )
    }
  </div>

  <div class="price">
    {
      !d.prenotabile ? (
        <small>{testi.camere.spazioDellaCasa}</small>
      ) : d.tariffaDa === null ? (
        <>
          <span class="blank">&nbsp;</span>
          <small>{testi.camere.perNotteColazione}</small>
        </>
      ) : (
        <>
          {testi.camere.daPrezzo(euro(lingua, d.tariffaDa))}
          <small>{testi.camere.perNotteColazione}</small>
          {!d.tariffaConfermata && (
            <span class="todo">{testi.camere.tariffaIndicativa}</span>
          )}
        </>
      )
    }
    {
      d.prenotabile && (
        <button class="btn sm" type="button" data-camera={d.nome[lingua]}>
          {testi.camere.prenota}
        </button>
      )
    }
  </div>
</div>
