---
import { casa } from "../data/casa";
import { linkWhatsApp, richiestaVuota } from "../data/prenotazione";
import { percorso, t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

// Indirizzo di partenza: il collegamento funziona anche senza JavaScript, che
// poi lo aggiorna con le date scelte (spec 003, FR-011).
const wa = linkWhatsApp(lingua, richiestaVuota(lingua));

const voci = [
  { href: "#camere", testo: testi.nav.voci.camere },
  { href: "#suite", testo: testi.nav.voci.suite },
  { href: "#mappa", testo: testi.nav.voci.mappa },
  { href: "#palazzo", testo: testi.nav.voci.palazzo },
  { href: "#galleria", testo: testi.nav.voci.galleria },
  { href: "#ortigia", testo: testi.nav.voci.ortigia },
  { href: "#domande", testo: testi.nav.voci.domande },
];
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href={percorso(lingua, "/")}>
      {casa.nome}
      <small>{casa.palazzo} · {casa.indirizzo.quartiere}</small>
    </a>

    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="menu"
    >
      {testi.nav.menu}
    </button>

    <nav class="principale" id="menu" aria-label={testi.nav.etichetta}>
      <ul>
        {voci.map((v) => <li><a href={v.href}>{v.testo}</a></li>)}
      </ul>
    </nav>

    <div class="navacts">
      <a class="btn hidemob" data-wa href={wa} target="_blank" rel="noopener">
        WhatsApp
      </a>
      <a class="btn solid" href="#prenota">{testi.nav.prenota}</a>
    </div>
  </div>
</header>

<script>
  // Il menu compatto sotto i 960 px: senza JavaScript la navigazione resta
  // visibile perché `hidden` viene messo solo qui (spec 001, FR-006 e FR-009).
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu");
  if (toggle && menu) {
    const compatto = window.matchMedia("(max-width: 960px)");
    const applica = () => {
      if (compatto.matches) {
        menu.hidden = toggle.getAttribute("aria-expanded") !== "true";
      } else {
        menu.hidden = false;
      }
    };
    toggle.addEventListener("click", () => {
      const aperto = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!aperto));
      applica();
    });
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).tagName === "A" && compatto.matches) {
        toggle.setAttribute("aria-expanded", "false");
        applica();
      }
    });
    compatto.addEventListener("change", applica);
    applica();
  }
</script>
