---
import { getCollection } from "astro:content";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);

const domande = (await getCollection("faq")).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);

// Dati strutturati solo per le domande che una risposta ce l'hanno davvero
// (spec 010, FR-003): dichiararne una vuota sarebbe peggio che non dichiararla.
const risposte = domande.filter((d) => d.data.risposta);
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: risposte.map((d) => ({
    "@type": "Question",
    name: d.data.domanda[lingua],
    acceptedAnswer: { "@type": "Answer", text: d.data.risposta![lingua] },
  })),
};
---

<section id="domande">
  <div class="wrap">
    <div class="sec-h">
      <h2>{testi.domande.titolo}</h2>
      <p class="kicker">{testi.domande.occhiello}</p>
    </div>

    {
      domande.map((d) => (
        <details open={d.data.apertaDiDefault}>
          <summary>{d.data.domanda[lingua]}</summary>
          {d.data.risposta ? (
            <p>{d.data.risposta[lingua]}</p>
          ) : (
            <p>
              <span class="todo">{testi.domande.senzaRisposta}</span>
              {testi.domande.spiegazioneSenzaRisposta}{" "}
              {d.data.daConfermare?.[lingua]}
            </p>
          )}
        </details>
      ))
    }
  </div>
</section>

{
  risposte.length > 0 && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  )
}
