---
import { casa } from "../data/casa";
import { t, type Lingua } from "../i18n";

interface Props {
  lingua: Lingua;
}
const { lingua } = Astro.props;
const testi = t(lingua);
const r = testi.confronto.righe;

interface Riga {
  voce: string;
  portale: string;
  diretto: string;
  daDefinire?: boolean;
}

const righe: Riga[] = [
  { voce: r.tariffa, portale: r.tariffaPortale, diretto: r.tariffaDiretto, daDefinire: true },
  {
    voce: r.colazione,
    portale: r.colazionePortale,
    diretto: casa.soggiorno.colazione.valore[lingua],
    daDefinire: !casa.soggiorno.colazione.confermato,
  },
  { voce: r.checkout, portale: r.checkoutPortale, diretto: r.checkoutDiretto },
  { voce: r.chiRisponde, portale: r.chiRispondePortale, diretto: r.chiRispondeDiretto },
  {
    voce: r.conferma,
    portale: r.confermaPortale,
    diretto: r.confermaDiretto(casa.contatti.rispostaEntro.valore[lingua]),
  },
  {
    voce: r.cancellazione,
    portale: r.cancellazionePortale,
    diretto: casa.soggiorno.cancellazione.valore?.[lingua] ?? r.cancellazioneDiretto,
    daDefinire: !casa.soggiorno.cancellazione.confermato,
  },
];
---

<section id="confronto">
  <div class="wrap">
    <div class="sec-h">
      <h2>{testi.confronto.titolo}</h2>
      <p class="kicker">{testi.confronto.occhiello}</p>
    </div>

    <div class="cmp-scroll">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col"><span class="solo-lettori">{testi.confronto.condizione}</span></th>
            <th scope="col">{testi.confronto.sulPortale}</th>
            <th scope="col">{testi.confronto.quiDiretto}</th>
          </tr>
        </thead>
        <tbody>
          {
            righe.map((riga) => (
              <tr>
                <th scope="row" style="font-weight:400">{riga.voce}</th>
                <td>{riga.portale}</td>
                <td class="you">
                  {riga.diretto}
                  {riga.daDefinire && (
                    <span class="todo">{testi.generale.daDefinire}</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="nota" style="max-width:60ch">{testi.confronto.nota}</p>
  </div>
</section>
