---
import Base from "../layouts/Base.astro";
---

<Base
  titolo="Pagina non trovata · Calamùrn"
  descrizione="La pagina cercata non esiste. Torna alla home del Calamùrn, in via Dione 58 a Ortigia."
  indicizzabile={false}
>
  <div class="wrap vuota">
    <p class="kicker">Errore 404</p>
    <h1>Questo indirizzo non porta da nessuna parte.</h1>
    <p>
      Il portone giusto è al 58 di via Dione. Se stavi cercando una camera, le
      quattro sono tutte in home.
    </p>
    <p style="margin-top:22px">
      <a class="btn solid" href="/">Torna alla home</a>
    </p>
  </div>
</Base>
