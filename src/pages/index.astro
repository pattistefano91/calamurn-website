---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { LINGUA_PREDEFINITA, t } from "../i18n";

const lingua = LINGUA_PREDEFINITA;
const testi = t(lingua);
---

<Base lingua={lingua} titolo={testi.meta.titolo} descrizione={testi.meta.descrizione}>
  <Home lingua={lingua} />
</Base>
